package main


func function(a int, b string, c bool, d Weird) int {
	println(a)
	println(b)
	println(c)
	println(d.eat(3, "", "")) // we know the method signature actually
	// it is a void one -> still we didn't check that body
	
	var e bool = false
	if (e == false) {
		var a int = 100
		var b int = 200
		println(a)
		println(b)
	}

	return 100
}


